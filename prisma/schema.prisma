// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Station {
  id                 String   @id @default(uuid())
  nameRomaji         String   // e.g., "Shinjuku"
  nameKanji          String   // e.g., "新宿"
  acceptedNames      String[] // List of strings for alternate names and spellings for easy autocomplete indexing

  // Geographic Hints (Tiles 3 & 7)
  prefecture         String   // e.g., "東京都", "神奈川県"
  municipality       String   // e.g., "渋谷区", "相模原市"
  latitude           Float    // Decimal degrees (WGS84)
  longitude          Float    // Decimal degrees (WGS84)

  // Transit Network Hints (Tiles 4 & 5)
  operators          String[] // Unique companies (e.g., ["JR 東日本", "東京メトロ"])
  lineCount          Int      // Total number of intersecting lines
  linesList          String[] // Names of lines (e.g., ["山手線", "田園都市線"])

  // Usage Stats Hints (Tile 6)
  passengerRank      Int      // Absolute numeric leaderboard standing
  passengerTier      String   // Pre-bracketed string: "上位10位", "上位50位", "上位100位", "上位250位", "上位250位圏外"

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dailyStationSequence DailyStationSequence? // One to One relation
}

model DailyStationSequence {
  dayIndex           Int       @id
  stationId          String    @unique // Reference to the station id
  station            Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  playDate           DateTime? @unique // Stores the date a station is used
}

model GameStatus {
  id              Int      @id @default(1) // Always 1 (we only ever need one row)
  currentDayIndex Int      @default(1)     // The simple incrementing counter (1 to 365)
  lastUpdatedDate String   // Stores "YYYY-MM-DD" to detect when a new calendar day arrives
}
